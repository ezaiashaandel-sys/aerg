// Ativ4.4 - Maior e menor
programa
{
    funcao inicio()
    {
        inteiro n

        leia(n)

        inteiro vetor[n]

        para (inteiro i = 0; i < n; i++)
        {
            leia(vetor[i])
        }

        inteiro maior = vetor[0]
        inteiro menor = vetor[0]

        para (inteiro i = 1; i < n; i++)
        {

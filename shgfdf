// Ativ4.10 - Ordenar valores
programa
{
    funcao inicio()
    {
        inteiro n, temp

        leia(n)

        inteiro vetor[n]

        para (inteiro i = 0; i < n; i++)
        {
            leia(vetor[i])
        }

        para (inteiro i = 0; i < n - 1; i++)
        {
            para (inteiro j = i + 1; j < n; j++)
            {
                se (vetor[i] > vetor[j])
                {
                    temp = vetor[i]
                    vetor[i] = vetor[j]
                    vetor[j] = temp
                }
            }
        }

        para (inteiro i = 0; i < n; i++)
        {
            escreva(vetor[i], "\n")
        }
    }
}



	// Crie um programa que leia N números inteiros, armazene-os em um
	// vetor e mostre o maior e o menor valor.
	// -----------------------------------------------------------------
	funcao exercicio_04()
	{
		inteiro n, vetor[100], maior, menor
		escreva("\n--- EXERCÍCIO 4: Maior e menor ---\n")
		escreva("Digite a quantidade de elementos (N): ")
		leia(n)

		para (inteiro i = 0; i < n; i++)
		{
			escreva("Digite o elemento ", i + 1, ": ")
			leia(vetor[i])
		}

		maior = vetor[0]
		menor = vetor[0]

		para (inteiro i = 1; i < n; i++)
		{
			se (vetor[i] > maior) { maior = vetor[i] }
			se (vetor[i] < menor) { menor = vetor[i] }
		}

		escreva("Maior valor: ", maior, "\n")
		escreva("Menor valor: ", menor, "\n")
	}


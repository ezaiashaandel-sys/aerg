// Ativ4.15 - MDC
programa
{
    funcao inteiro mdc(inteiro a, inteiro b)
    {
        inteiro resto

        enquanto (b != 0)
        {
            resto = a % b
            a = b
            b = resto
        }

        retorne a
    }

    funcao inicio()
    {
        inteiro a, b, resultado

        leia(a)
        leia(b)

        resultado = mdc(a, b)

        escreva(resultado)
    }
}



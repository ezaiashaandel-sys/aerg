	// -----------------------------------------------------------------
	// 1. Ler e exibir pares
	// Crie um programa que leia N números inteiros, armazene-os em um
	// vetor e exiba apenas os que são pares, na ordem lida.
	// -----------------------------------------------------------------
	funcao exercicio_01()
	{
		inteiro n, vetor[100]
		escreva("\n--- EXERCÍCIO 1: Ler e exibir pares ---\n")
		escreva("Digite a quantidade de elementos (N): ")
		leia(n)

		para (inteiro i = 0; i < n; i++)
		{
			escreva("Digite o elemento ", i + 1, ": ")
			leia(vetor[i])
		}

		escreva("Elementos pares: ")
		para (inteiro i = 0; i < n; i++)
		{
			se (vetor[i] % 2 == 0)
			{
				escreva(vetor[i], " ")
			}
		}
		escreva("\n")
	}

	// -----------------------------------------------------------------
	// 2. Inverter ordem
	// Crie um programa que leia N números inteiros, armazene-os em um
	// vetor e imprima os elementos na ordem inversa.
	// -----------------------------------------------------------------
	funcao exercicio_02()
	{
		inteiro n, vetor[100]
		escreva("\n--- EXERCÍCIO 2: Inverter ordem ---\n")
		escreva("Digite a quantidade de elementos (N): ")
		leia(n)

		para (inteiro i = 0; i < n; i++)
		{
			escreva("Digite o elemento ", i + 1, ": ")
			leia(vetor[i])
		}

		escreva("Vetor na ordem inversa: ")
		para (inteiro i = n - 1; i >= 0; i--)
		{
			escreva(vetor[i], " ")
		}
		escreva("\n")
	}


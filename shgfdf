	{
		se (media >= 7.0) { retorne "Aprovado" }
		senao se (media >= 5.0) { retorne "Recuperação" }
		senao { retorne "Reprovado" }
	}

	// 14. Função auxiliar
	funcao inteiro func_fatorial(inteiro n)
	{
		inteiro fat = 1
		para (inteiro i = 1; i <= n; i++)
		{
			fat = fat * i
		}
		retorne fat
	}

	// 15. Função auxiliar
	funcao inteiro func_mdc(inteiro a, inteiro b)
	{
		inteiro resto
		enquanto (b != 0)
		{
			resto = a % b
			a = b
			b = resto
		}
		retorne a
	}

	// 16. Função auxiliar
	funcao logico func_eh_maior_de_idade(inteiro idade)
	{
		retorne (idade >= 18)
	}

	// 17. Função auxiliar
	funcao logico func_eh_primo(inteiro n)
	{
		se (n <= 1) { retorne falso }
		para (inteiro i = 2; i * i <= n; i++)
		{
			se (n % i == 0) { retorne falso }
		}
		retorne verdadeiro
	}

	// 18. Função auxiliar
	funcao real func_calcular(real a, real b, caracter op)
	{
		se (op == '+') { retorne a + b }
		senao se (op == '-') { retorne a - b }
		senao se (op == '*') { retorne a * b }
		senao se (op == '/') 
		{
			se (b != 0) { retorne a / b }
			senao 
			{
				escreva("Erro: Divisão por zero!\n")
				retorne 0.0
			}
		}
		retorne 0.0
	}

	// 19. Funções auxiliares
	funcao real func_cParaF(real c) { retorne (c * 9/5) + 32 }
	funcao real func_fParaC(real f) { retorne (f - 32) * 5/9 }


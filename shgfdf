// Ativ4.17 - Número primo
programa
{
    funcao logico primo(inteiro n)
    {
        se (n < 2)
        {
            retorne falso
        }

        para (inteiro i = 2; i < n; i++)
        {
            se (n % i == 0)
            {
                retorne falso
            }
        }

        retorne verdadeiro
    }

    funcao inicio()
    {
        inteiro n

        leia(n)

        se (primo(n))
        {
            escreva("Primo")
        }
        senao
        {
            escreva("Não primo")
        }
    }
}


// Ativ4.18 - Calculadora
programa
{
    funcao real calcular(real a, real b, cadeia op)
    {
        se (op == "+")
        {
            retorne a + b
        }
        senao se (op == "-")
        {
            retorne a - b
        }
        senao se (op == "*")
        {
            retorne a * b
        }
        senao se (op == "/")
        {
            se (b == 0)
            {
                escreva("Divisão por zero")
                retorne 0
            }

            retorne a / b
        }

        retorne 0
    }

    funcao inicio()
    {
        real a, b, resultado
        cadeia op

        leia(a)
        leia(b)
        leia(op)

        resultado = calcular(a, b, op)

        escreva(resultado)
    }
}


// Ativ4.19 - Conversão de temperatura
programa
{
    funcao real cParaF(real c)
    {
        retorne (c * 9 / 5) + 32
    }

    funcao real fParaC(real f)
    {
        retorne (f - 32) * 5 / 9
    }

    funcao inicio()
    {
        real valor, resultado
        cadeia tipo

        leia(valor)
        leia(tipo)

        se (tipo == "C")
        {
            resultado = cParaF(valor)
            escreva(resultado, " F")
        }
        senao
        {
            resultado = fParaC(valor)
            escreva(resultado, " C")
        }
    }
}



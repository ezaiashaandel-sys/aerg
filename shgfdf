	// 5. Acima da média
	// Crie um programa que leia N valores reais, calcule a média da
	// turma e exiba apenas os valores estritamente acima da média.
	// -----------------------------------------------------------------
	funcao exercicio_05()
	{
		inteiro n
		real notas[100], soma = 0.0, media
		escreva("\n--- EXERCÍCIO 5: Acima da média ---\n")
		escreva("Digite a quantidade de alunos (N): ")
		leia(n)

		para (inteiro i = 0; i < n; i++)
		{
			escreva("Digite a nota do aluno ", i + 1, ": ")
			leia(notas[i])
			soma = soma + notas[i]
		}

		media = soma / n
		escreva("Média da turma: ", media, "\n")
		escreva("Notas acima da média: ")

		para (inteiro i = 0; i < n; i++)
		{
			se (notas[i] > media)
			{
				escreva(notas[i], " ")
			}
		}
		escreva("\n")
	}


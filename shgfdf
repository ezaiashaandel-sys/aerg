	// 10. Ordenar valores
	// Crie um programa que leia N números inteiros, armazene-os em um
	// vetor, ordene-os em ordem crescente e exiba o resultado.
	// -----------------------------------------------------------------
	funcao exercicio_10()
	{
		inteiro n, vetor[100], aux
		escreva("\n--- EXERCÍCIO 10: Ordenar valores ---\n")
		escreva("Digite a quantidade de elementos (N): ")
		leia(n)

		para (inteiro i = 0; i < n; i++)
		{
			escreva("Digite o elemento ", i + 1, ": ")
			leia(vetor[i])
		}

		// Bubble Sort
		para (inteiro i = 0; i < n - 1; i++)
		{
			para (inteiro j = 0; j < n - 1 - i; j++)
			{
				se (vetor[j] > vetor[j + 1])
				{
					aux = vetor[j]
					vetor[j] = vetor[j + 1]
					vetor[j + 1] = aux
				}
			}
		}

		escreva("Vetor ordenado em ordem crescente: ")
		para (inteiro i = 0; i < n; i++)
		{
			escreva(vetor[i], " ")
		}
		escreva("\n")
	}

